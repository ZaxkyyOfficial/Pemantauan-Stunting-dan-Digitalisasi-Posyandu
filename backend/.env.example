# ============================================
# TumbuhSehat Backend - Environment Variables
# ============================================
# Salin file ini menjadi .env dan sesuaikan nilainya

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Database MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=db_posyandu_stunting

# --- JWT Authentication ---
JWT_SECRET=tumbuhsehat_supersecret_key_change_me
JWT_EXPIRES_IN=24h

# --- AES-CBC Encryption (Modul 18) ---
CRYPTO_SECRET_KEY=TumbuhSehatSecretKey16B
CRYPTO_IV=TumbuhSehatIV16B!

# --- Supabase Cloud Replicator (Modul Sinkronisasi Bertingkat) ---
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_key
SUPABASE_SYNC_INTERVAL_MS=300000
