<aside class="sidebar" role="navigation">
  <div class="sidebar-header">
    <img src="/public/images/logo.png" alt="Logo TumbuhSehat" class="sidebar-logo w-10 h-10 object-contain max-h-12 max-w-12" style="width: 40px; height: 40px; object-fit: contain; max-height: 48px; max-width: 48px;">
    <div>
      <div class="sidebar-brand-name">TumbuhSehat</div>
      <div class="sidebar-brand-sub">Surveilans Gizi Posyandu</div>
    </div>
  </div>

  <div class="sidebar-section-title">Navigasi Utama</div>
  <nav class="sidebar-nav">
    <a href="/dashboard" class="sidebar-link <%= (typeof activeMenu !== 'undefined' && activeMenu === 'dashboard') ? 'active' : '' %>">
      <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect width="7" height="9" x="3" y="3" rx="1"/>
        <rect width="7" height="5" x="14" y="3" rx="1"/>
        <rect width="7" height="9" x="14" y="12" rx="1"/>
        <rect width="7" height="5" x="3" y="16" rx="1"/>
      </svg>
      <span>Ringkasan Wilayah</span>
    </a>

    <a href="/anak-web" class="sidebar-link <%= (typeof activeMenu !== 'undefined' && activeMenu === 'anak') ? 'active' : '' %>">
      <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
        <circle cx="9" cy="7" r="4"/>
        <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
      </svg>
      <span>Data Sasaran Balita</span>
    </a>

    <a href="/mpasi-web" class="sidebar-link <%= (typeof activeMenu !== 'undefined' && activeMenu === 'mpasi') ? 'active' : '' %>">
      <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 8h1a4 4 0 0 1 0 8h-1"/>
        <path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/>
        <line x1="6" x2="6" y1="1" y2="4"/>
        <line x1="10" x2="10" y1="1" y2="4"/>
        <line x1="14" x2="14" y1="1" y2="4"/>
      </svg>
      <span>Rekomendasi Menu Lokal</span>
    </a>

    <a href="/sync-web" class="sidebar-link <%= (typeof activeMenu !== 'undefined' && activeMenu === 'sync') ? 'active' : '' %>">
      <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
        <path d="M3 3v5h5"/>
        <path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/>
        <path d="M16 21h5v-5"/>
      </svg>
      <span>Validasi Sinkronisasi</span>
    </a>

    <a href="/laporan-web" class="sidebar-link <%= (typeof activeMenu !== 'undefined' && activeMenu === 'laporan') ? 'active' : '' %>">
      <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/>
        <path d="M14 2v4a2 2 0 0 0 2 2h4"/>
        <path d="M8 13h2"/>
        <path d="M14 13h2"/>
        <path d="M8 17h2"/>
        <path d="M14 17h2"/>
      </svg>
      <span>Ekspor Laporan e-PPGBM</span>
    </a>
  </nav>

  <div class="sidebar-footer">
    <div class="user-info">
      <div class="user-avatar">
        <%= (typeof user !== 'undefined' && user && user.nama) ? user.nama.substring(0, 2).toUpperCase() : 'OP' %>
      </div>
      <div class="user-details">
        <div class="user-name"><%= (typeof user !== 'undefined' && user && user.nama) ? user.nama : 'Operator Puskesmas' %></div>
        <div class="user-role"><%= (typeof user !== 'undefined' && user && user.peran) ? user.peran : 'Petugas Gizi' %></div>
      </div>
    </div>
    <a href="/logout" class="btn-logout">Keluar Sistem</a>
  </div>
</aside>
