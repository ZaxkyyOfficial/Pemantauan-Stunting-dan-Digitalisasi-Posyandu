<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --spruce: #0C2E28;
      --spruce-light: #16433B;
      --spruce-dark: #071C18;
      --sage: #4E8752;
      --sage-muted: #EBF2EC;
      --terracotta: #C85A32;
      --terracotta-muted: #FAECE7;
      --bone: #F8FAFC;
      --surface: #FFFFFF;
      --text-main: #0F172A;
      --text-muted: #475569;
      --border: #E2E8F0;
      --border-dark: #CBD5E1;
      --sidebar-width: 260px;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Inter', sans-serif;
      background-color: var(--bone);
      color: var(--text-main);
      display: flex;
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
    }

    .sidebar {
      width: var(--sidebar-width);
      height: 100vh;
      background: var(--spruce);
      position: fixed;
      left: 0;
      top: 0;
      display: flex;
      flex-direction: column;
      border-right: 1px solid rgba(255, 255, 255, 0.08);
      z-index: 100;
    }

    .sidebar-header {
      padding: 1.5rem 1.25rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .sidebar-logo {
      width: 36px;
      height: 36px;
      object-fit: contain;
    }

    .sidebar-brand-name {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 0.8125rem;
      font-weight: 800;
      color: #FFFFFF;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      line-height: 1.2;
    }

    .sidebar-brand-sub {
      font-size: 0.6875rem;
      color: #94A3B8;
      letter-spacing: 0.02em;
    }

    .sidebar-section-title {
      padding: 1.25rem 1.25rem 0.5rem;
      font-size: 0.6875rem;
      font-weight: 700;
      color: #64748B;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }

    .sidebar-nav {
      flex: 1;
      padding: 0.25rem 0.75rem;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .sidebar-link {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.625rem 0.875rem;
      border-radius: 6px;
      color: #CBD5E1;
      text-decoration: none;
      font-size: 0.8125rem;
      font-weight: 500;
      transition: background-color 0.12s ease, color 0.12s ease;
    }

    .sidebar-link:hover {
      background: var(--spruce-light);
      color: #FFFFFF;
    }

    .sidebar-link.active {
      background: #123C34;
      color: #FFFFFF;
      font-weight: 600;
      border-left: 3px solid var(--sage);
    }

    .sidebar-link .nav-icon {
      flex-shrink: 0;
      color: #94A3B8;
      transition: color 0.12s ease;
    }

    .sidebar-link:hover .nav-icon,
    .sidebar-link.active .nav-icon {
      color: #A7F3D0;
    }

    .sidebar-footer {
      padding: 1rem 1.25rem;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      background: var(--spruce-dark);
    }

    .user-info {
      display: flex;
      align-items: center;
      gap: 0.625rem;
      margin-bottom: 0.75rem;
    }

    .user-avatar {
      width: 32px;
      height: 32px;
      border-radius: 4px;
      background: #16433B;
      color: #FFFFFF;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.75rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .user-details {
      flex: 1;
      overflow: hidden;
    }

    .user-name {
      font-size: 0.8125rem;
      font-weight: 600;
      color: #FFFFFF;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .user-role {
      font-size: 0.6875rem;
      color: #94A3B8;
    }

    .btn-logout {
      display: block;
      width: 100%;
      padding: 0.45rem 0.5rem;
      text-align: center;
      font-size: 0.75rem;
      font-weight: 600;
      color: #CBD5E1;
      background: transparent;
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 4px;
      text-decoration: none;
      transition: background-color 0.15s ease;
    }

    .btn-logout:hover {
      background: rgba(200, 90, 50, 0.2);
      border-color: var(--terracotta);
      color: #FFFFFF;
    }

    .main-wrapper {
      margin-left: var(--sidebar-width);
      flex: 1;
      min-width: 0;
      display: flex;
      flex-direction: column;
    }

    .topbar {
      height: 60px;
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      padding: 0 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 50;
    }

    .breadcrumb {
      font-size: 0.8125rem;
      color: var(--text-muted);
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .breadcrumb-active {
      font-weight: 600;
      color: var(--spruce);
    }

    .content-area {
      padding: 1.75rem 2rem 3rem;
    }

    .page-header-row {
      margin-bottom: 1.5rem;
    }

    .page-title {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 1.375rem;
      font-weight: 700;
      color: var(--spruce);
      letter-spacing: -0.02em;
    }

    .page-desc {
      font-size: 0.8125rem;
      color: var(--text-muted);
      margin-top: 0.25rem;
    }

    .telemetry-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
      margin-bottom: 1.75rem;
    }

    @media (max-width: 860px) {
      .telemetry-grid {
        grid-template-columns: 1fr;
      }
    }

    .telemetry-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 1.25rem;
    }

    .telemetry-label {
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .telemetry-val {
      font-family: 'JetBrains Mono', monospace;
      font-size: 1.75rem;
      font-weight: 700;
      color: var(--spruce);
      margin: 0.35rem 0 0.2rem;
    }

    .telemetry-sub {
      font-size: 0.75rem;
      color: var(--text-muted);
    }

    .table-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 6px;
      overflow: hidden;
      margin-bottom: 1.75rem;
    }

    .table-header {
      padding: 1rem 1.25rem;
      border-bottom: 1px solid var(--border);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .table-title {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 0.9375rem;
      font-weight: 700;
      color: var(--spruce);
    }

    .spreadsheet-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.8125rem;
      text-align: left;
    }

    .spreadsheet-table th {
      background: #F1F5F9;
      color: #334155;
      font-weight: 600;
      font-size: 0.6875rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      padding: 0.75rem 1rem;
      border-bottom: 1px solid var(--border);
    }

    .spreadsheet-table td {
      padding: 0.875rem 1rem;
      border-bottom: 1px solid var(--border);
      vertical-align: middle;
    }

    .spreadsheet-table tr:hover {
      background: #F8FAFC;
    }

    .tabular-num {
      font-family: 'JetBrains Mono', monospace;
      font-variant-numeric: tabular-nums;
    }

    .badge-success {
      display: inline-block;
      padding: 2px 8px;
      border-radius: 4px;
      font-size: 0.6875rem;
      font-weight: 600;
      background: var(--sage-muted);
      color: var(--sage);
      border: 1px solid rgba(78, 135, 82, 0.3);
    }

    .badge-pending {
      display: inline-block;
      padding: 2px 8px;
      border-radius: 4px;
      font-size: 0.6875rem;
      font-weight: 600;
      background: #FEF3C7;
      color: #D97706;
      border: 1px solid rgba(217, 119, 6, 0.3);
    }

    .badge-failed {
      display: inline-block;
      padding: 2px 8px;
      border-radius: 4px;
      font-size: 0.6875rem;
      font-weight: 600;
      background: var(--terracotta-muted);
      color: var(--terracotta);
      border: 1px solid rgba(200, 90, 50, 0.3);
    }

    .badge-online {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 2px 8px;
      border-radius: 4px;
      font-size: 0.6875rem;
      font-weight: 600;
      background: var(--sage-muted);
      color: var(--sage);
    }

    .status-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--sage);
    }

    .json-code {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.75rem;
      color: #475569;
      background: #F8FAFC;
      padding: 2px 6px;
      border-radius: 3px;
      max-width: 320px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      display: inline-block;
    }
  </style>
</head>
<body>

  <%- include('partials/sidebar', { activeMenu: 'sync', user }) %>

  <div class="main-wrapper">
    <header class="topbar">
      <div class="breadcrumb">
        <span>Surveilans</span>
        <span>/</span>
        <span class="breadcrumb-active">Validasi Sinkronisasi Offline-First</span>
      </div>
      <div>
        <span class="tabular-num" style="font-size: 0.8125rem; color: var(--text-muted);">
          Protokol: <strong>Two-Way Sync Hub v1</strong>
        </span>
      </div>
    </header>

    <main class="content-area">
      <div class="page-header-row">
        <h1 class="page-title">Validasi & Audit Telemetri Sinkronisasi</h1>
        <p class="page-desc">Pemantauan mutasi data batch offline-first dari gawai kader posyandu ke server pusat puskesmas.</p>
      </div>

      <div class="telemetry-grid">
        <div class="telemetry-card">
          <div class="telemetry-label">Total Transaksi Batch</div>
          <div class="telemetry-val tabular-num"><%= syncLogs.length %></div>
          <div class="telemetry-sub">Mutasi data tersimpan di server</div>
        </div>

        <div class="telemetry-card">
          <div class="telemetry-label">Status Antrean Terproses</div>
          <div class="telemetry-val tabular-num" style="color: var(--sage);">100%</div>
          <div class="telemetry-sub">Semua batch terverifikasi ACID</div>
        </div>

        <div class="telemetry-card">
          <div class="telemetry-label">Gawai Kader Terhubung</div>
          <div class="telemetry-val tabular-num"><%= perangkatList.length %></div>
          <div class="telemetry-sub">Perangkat posyandu aktif 24 jam</div>
        </div>
      </div>

      <div class="table-card">
        <div class="table-header">
          <h2 class="table-title">Riwayat Log Mutasi Sinkronisasi (Antrean Server)</h2>
          <span style="font-size: 0.75rem; color: var(--text-muted);">Format Idempoten MySQL</span>
        </div>
        <table class="spreadsheet-table">
          <thead>
            <tr>
              <th>ID Batch</th>
              <th>Entitas Tabel</th>
              <th>ID Referensi</th>
              <th>Operasi (Aksi)</th>
              <th>Payload Data JSON</th>
              <th>Status Eksekusi</th>
            </tr>
          </thead>
          <tbody>
            <% if (syncLogs.length === 0) { %>
              <tr>
                <td colspan="6" style="text-align: center; padding: 2rem; color: var(--text-muted);">
                  Belum ada log transaksi sinkronisasi yang tercatat.
                </td>
              </tr>
            <% } else { %>
              <% syncLogs.forEach(log => { %>
                <tr>
                  <td class="tabular-num" style="font-weight: 600; color: var(--spruce);">#SYNC-<%= String(log.id).padStart(4, '0') %></td>
                  <td>
                    <span style="font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; font-weight: 600; color: var(--spruce);">
                      <%= log.nama_tabel %>
                    </span>
                  </td>
                  <td class="tabular-num"><%= log.id_referensi %></td>
                  <td>
                    <span style="font-weight: 600; font-size: 0.6875rem; color: #0369A1;">
                      <%= log.aksi %>
                    </span>
                  </td>
                  <td>
                    <span class="json-code" title="<%= typeof log.data_json === 'string' ? log.data_json : JSON.stringify(log.data_json) %>">
                      <%= typeof log.data_json === 'string' ? log.data_json : JSON.stringify(log.data_json) %>
                    </span>
                  </td>
                  <td>
                    <% if (log.status_sync === 'Berhasil') { %>
                      <span class="badge-success">Berhasil Terverifikasi</span>
                    <% } else if (log.status_sync === 'Pending') { %>
                      <span class="badge-pending">Antrean Pending</span>
                    <% } else { %>
                      <span class="badge-failed">Gagal / Ditolak</span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>

      <div class="table-card">
        <div class="table-header">
          <h2 class="table-title">Perangkat Gawai Kader Terdaftar</h2>
          <span style="font-size: 0.75rem; color: var(--text-muted);">Autentikasi Token Offline-First</span>
        </div>
        <table class="spreadsheet-table">
          <thead>
            <tr>
              <th>Kode Perangkat</th>
              <th>Posyandu Wilayah</th>
              <th>Waktu Sinkron Terakhir</th>
              <th>Status Konektivitas</th>
            </tr>
          </thead>
          <tbody>
            <% perangkatList.forEach(dev => { %>
              <tr>
                <td style="font-weight: 600; font-family: 'JetBrains Mono', monospace; color: var(--spruce);">
                  <%= dev.kode_perangkat %>
                </td>
                <td><%= dev.nama_posyandu || 'Posyandu Sukamaju' %></td>
                <td class="tabular-num"><%= dev.waktu_sync || 'Baru saja' %></td>
                <td>
                  <span class="badge-online">
                    <span class="status-dot"></span>
                    <span>Aktif 24 Jam</span>
                  </span>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </main>
  </div>
</body>
</html>
