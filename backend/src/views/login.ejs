<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --spruce: #0C2E28;
      --spruce-light: #16433B;
      --sage: #4E8752;
      --sage-muted: #EBF2EC;
      --terracotta: #C85A32;
      --terracotta-muted: #FAECE7;
      --bone: #F8FAFC;
      --surface: #FFFFFF;
      --text-main: #0F172A;
      --text-muted: #475569;
      --border: #E2E8F0;
      --focus-ring: #0C2E28;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Inter', sans-serif;
      background-color: var(--bone);
      color: var(--text-main);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
      -webkit-font-smoothing: antialiased;
    }

    .auth-container {
      width: 100%;
      max-width: 420px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 2.25rem 2rem;
    }

    .auth-header {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      margin-bottom: 1.75rem;
      border-bottom: 1px solid var(--border);
      padding-bottom: 1.5rem;
    }

    .auth-logo {
      width: 56px;
      height: 56px;
      object-fit: contain;
      margin-bottom: 0.85rem;
    }

    .auth-title {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--spruce);
      letter-spacing: -0.02em;
    }

    .auth-subtitle {
      font-size: 0.8125rem;
      color: var(--text-muted);
      margin-top: 0.35rem;
      line-height: 1.4;
    }

    .alert {
      padding: 0.75rem 1rem;
      border-radius: 6px;
      font-size: 0.8125rem;
      font-weight: 500;
      margin-bottom: 1.25rem;
      line-height: 1.4;
    }

    .alert-error {
      background: var(--terracotta-muted);
      color: var(--terracotta);
      border: 1px solid rgba(200, 90, 50, 0.3);
    }

    .alert-success {
      background: var(--sage-muted);
      color: var(--sage);
      border: 1px solid rgba(78, 135, 82, 0.3);
    }

    .form-group {
      margin-bottom: 1.125rem;
    }

    label {
      display: block;
      font-size: 0.8125rem;
      font-weight: 600;
      color: var(--text-main);
      margin-bottom: 0.375rem;
    }

    input[type="email"],
    input[type="password"] {
      width: 100%;
      height: 44px;
      padding: 0 0.875rem;
      border: 1px solid var(--border);
      border-radius: 6px;
      font-size: 0.875rem;
      font-family: inherit;
      color: var(--text-main);
      background: #FFFFFF;
      transition: border-color 0.15s ease;
    }

    input:focus {
      outline: 2px solid var(--focus-ring);
      outline-offset: 1px;
      border-color: var(--spruce);
    }

    .btn-submit {
      width: 100%;
      height: 44px;
      background: var(--spruce);
      color: #FFFFFF;
      border: 1px solid var(--spruce);
      border-radius: 6px;
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 0.875rem;
      font-weight: 600;
      cursor: pointer;
      margin-top: 0.5rem;
      transition: background-color 0.15s ease;
    }

    .btn-submit:hover {
      background: var(--spruce-light);
    }

    .btn-submit:focus-visible {
      outline: 2px solid var(--focus-ring);
      outline-offset: 2px;
    }

    .auth-footer-nav {
      margin-top: 1.25rem;
      padding-top: 1.25rem;
      border-top: 1px solid var(--border);
      font-size: 0.8125rem;
      color: var(--text-muted);
      text-align: center;
    }

    .auth-footer-nav a {
      color: var(--spruce);
      font-weight: 600;
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    .auth-footer-nav a:hover {
      color: var(--spruce-light);
    }

    .clinical-disclaimer {
      margin-top: 1.25rem;
      font-size: 0.75rem;
      color: #64748B;
      text-align: center;
    }
  </style>
</head>
<body>

  <main class="auth-container" role="main">
    <header class="auth-header">
      <img src="/public/images/logo.png" alt="Logo Resmi TumbuhSehat" class="auth-logo" onerror="this.style.display='none'">
      <h1 class="auth-title">Surveilans Gizi Puskesmas</h1>
      <p class="auth-subtitle">Sistem Pemantauan Stunting dan Digitalisasi Posyandu</p>
    </header>

    <% if (error) { %>
      <div class="alert alert-error" role="alert">
        <%= error %>
      </div>
    <% } %>

    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success" role="status">
        <%= success %>
      </div>
    <% } %>

    <form action="/login" method="POST" novalidate>
      <div class="form-group">
        <label for="email">Email Resmi Petugas</label>
        <input 
          type="email" 
          id="email" 
          name="email" 
          autocomplete="email" 
          required 
          placeholder="petugas@puskesmas.go.id"
        >
      </div>

      <div class="form-group">
        <label for="password">Kata Sandi Akun</label>
        <input 
          type="password" 
          id="password" 
          name="password" 
          autocomplete="current-password" 
          required 
          placeholder="Masukkan kata sandi"
        >
      </div>

      <button type="submit" class="btn-submit">Masuk ke Portal Surveilans</button>
    </form>

    <div class="auth-footer-nav">
      Belum memiliki akun petugas? <a href="/register">Registrasi Akun Baru</a>
    </div>

    <footer class="clinical-disclaimer">
      Kementerian Kesehatan Republik Indonesia &bull; Standar Baku e-PPGBM 2026
    </footer>
  </main>

</body>
</html>
