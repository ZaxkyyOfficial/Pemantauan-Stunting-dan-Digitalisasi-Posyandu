<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="@dimen/radius_md"
    app:cardElevation="0dp"
    app:strokeColor="@color/card_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvNomorAntrean"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_surface_container"
                android:gravity="center"
                android:textColor="@color/spruce"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                tools:text="#01" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNamaBalita"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/spruce"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="Muhammad Bilal" />

                <TextView
                    android:id="@+id/tvSubInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="12sp"
                    tools:text="Laki-laki • 11 Bulan • Ibu Fatimah" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStatusAntrean"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_normal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/sage"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Selesai" />
        </LinearLayout>

        <!-- Faltering alert tag if detected -->
        <TextView
            android:id="@+id/tvFalteringBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_chip_danger"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="Faltering Alert (T/2T)"
            android:textColor="@color/terracotta"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="8dp"
            android:background="@color/divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDetailPengukuran"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/on_surface_variant"
                android:textSize="11.5sp"
                android:fontFamily="monospace"
                tools:text="BB: 8.70 kg • TB: 73.0 cm" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRekamMedis"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:layout_marginEnd="8dp"
                android:text="Rekam"
                android:textColor="@color/spruce"
                android:textSize="11.5sp"
                android:textStyle="bold"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp"
                app:cornerRadius="@dimen/radius_md"
                android:paddingHorizontal="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTimbang"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minHeight="48dp"
                app:backgroundTint="@color/spruce"
                android:text="+ Timbang"
                android:textColor="@color/white"
                android:textSize="11.5sp"
                android:textStyle="bold"
                app:elevation="0dp"
                app:cornerRadius="@dimen/radius_md"
                android:paddingHorizontal="12dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
